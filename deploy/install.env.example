# k8s-ai 四期一键安装参数模板（P6.4）
#
# 用法：
#   cp deploy/install.env.example install.env
#   vi install.env            # 只改需要改的行，其余保持注释即用内置默认
#   chmod 600 install.env     # 可能含口令与密钥，权限收紧，且不要提交进 Git
#   deploy/install.sh --env-file install.env --dry-run   # 先预演
#   deploy/install.sh --env-file install.env             # 再真装
#
# 规则：
#   1. 每行一个 KEY=VALUE；行首 # 是注释，注释掉的行等于「不设置，用脚本内置默认」。
#   2. 优先级：命令行 --KEY=VALUE > 导出的环境变量 > 本文件 > 脚本内置默认。
#   3. 值可以带成对引号（DSN 这类含特殊字符的推荐加单引号），脚本会去掉引号。
#   4. 下面给的都是占位示例，照抄必然装不上：镜像仓库、域名、存储类、DSN 由现场决定。

# --- 镜像与构建 --------------------------------------------------------------
# 后端镜像地址，不含标签（★必填）。脚本不会内置任何真实仓库地址。
#IMAGE=registry.internal/platform/k8s-ai
# 镜像标签（★必填），例 4.0.0
#TAG=4.0.0
# 前端镜像地址，不含标签。仅 FORM=separated（前后端分离）必填。
#IMAGE_WEB=registry.internal/platform/k8s-ai-web
# 是否由脚本构建镜像。探测不到 docker/podman 时自动降级为「只发布不构建」。
#BUILD=true
# 构建后是否推送镜像仓库。集群拉不到本地镜像时必须 true。
#PUSH=true
# 离线交付：从 docker save 产出的 tar 导入镜像并跳过构建，填 tar 路径。
#LOAD_TAR=
# 拉取策略：IfNotPresent（内网常用）/ Always。
#IMAGE_PULL_POLICY=IfNotPresent
# 私有仓库拉取凭据。两种写法：集群里已存在的 Secret 名，或 dockerconfigjson 文件路径
# （给了文件路径脚本会自建名为 k8s-ai-registry 的 Secret）。HTTP 仓库还需要节点
# containerd 配好 insecure，见 docs/03-运维与部署/01-部署与安装.md。
#IMAGE_PULL_SECRET=
# 构建用 Go 代理。留空则读 ~/.k8s-ai/goproxy.txt，再退回内置默认。
#GOPROXY=https://goproxy.internal,direct
# 内置进镜像的 kubectl 版本；留空 = 不内置 kubectl（保留 shell 工具层）。
#KUBECTL_VERSION=v1.28.13
# kubectl 下载基址，目录结构需与 dl.k8s.io/release 一致。纯内网改成内网 mirror，
# 或者把二进制放进 deploy/kubectl/ 走离线投递（优先于下载）。
#KUBECTL_DOWNLOAD_BASE=https://files.m.daocloud.io/dl.k8s.io/release

# --- 发布形态 ----------------------------------------------------------------
# 部署形态：allinone（形态 A，一体化镜像，默认）/ separated（形态 B，前后端分离）
#FORM=allinone
# 命名空间，默认 k8s-ai。改名会把全部清单里的命名空间引用一起改写。
#NAMESPACE=k8s-ai
# 对外暴露方式：nodeport（默认，无需域名）/ ingress / none（只做集群内访问）。
#EXPOSE=nodeport
# NodePort 端口号。留空 = 由集群随机分配（脚本会回读实际端口并打印访问地址）。
#NODE_PORT=30080
# Ingress 域名。EXPOSE=ingress 时必填；用自定义域名时客户端需要配 hosts 解析。
#INGRESS_HOST=k8s-ai.internal.example
# IngressClass 名字。留空用 nginx；先 kubectl get ingressclass 确认现场类名。
#INGRESS_CLASS=

# --- 业务存储 ----------------------------------------------------------------
# 存储驱动：mysql（主口径）/ sqlite（单机兜底，数据必须落 PVC）。
#STORE_DRIVER=mysql
# MySQL DSN，STORE_DRIVER=mysql 时必填。只写进 Secret/k8s-ai-store，绝不进 ConfigMap。
# 库与账号需 DBA 预建，建议 utf8mb4。
#MYSQL_DSN='user:pass@tcp(db.internal:3306)/k8s_ai?charset=utf8mb4'
# SQLite 库文件路径（落在 PVC 上），仅 STORE_DRIVER=sqlite 生效。
#SQLITE_PATH=/data/k8s-ai.db
# 是否创建 PVC 并挂载 /reports。默认 true；false 时报告写 emptyDir，重启即丢。
#PERSIST_REPORTS=true
# StorageClass 名字。留空 = 用集群默认存储类（无默认存储类会拒绝并打印可选列表）。
#STORAGE_CLASS=
# 报告 PVC 容量。
#REPORT_STORAGE_SIZE=5Gi

# --- 对象存储（会话附件 / 大对象，P8）----------------------------------------
# 后端：db（默认，存 MySQL，零外部依赖）/ dir（本地目录，单副本）/ s3（S3 兼容）。
#BLOBS_BACKEND=db
# S3 兼容端点，host:port 形式。driver=s3 必填。
#BLOBS_ENDPOINT=s3.internal:9000
# 桶名。driver=s3 必填。
#BLOBS_BUCKET=k8s-ai
# 访问密钥 ID。driver=s3 必填，只落 Secret/k8s-ai-blobs。
#BLOBS_ACCESS_KEY=
# 访问密钥 Secret。driver=s3 必填，只落 Secret/k8s-ai-blobs，不进清单明文。
#BLOBS_SECRET_KEY=
# 区域名，S3 签名用；MinIO 常见填 us-east-1。
#BLOBS_REGION=us-east-1
# 是否启用 TLS。自建 MinIO 走 HTTP 时填 false。
#BLOBS_USE_TLS=false
# 是否用路径风格寻址（http://host/bucket/key）。自建 MinIO 通常 true。
#BLOBS_PATH_STYLE=true
# 桶不存在时是否自动创建（需要凭据有建桶权限）。
#BLOBS_CREATE_BUCKET=true
# 对象 key 前缀，多套环境共用一个桶时用来隔离。留空不注入。
#BLOBS_PREFIX=
# 是否由本脚本一并部署 MinIO。自带 MinIO 清单随 P8.8 交付，当前开启会被拒绝，
# 请先用 BLOBS_BACKEND=s3 对接现场已有的 MinIO / 任意 S3 兼容存储。
#ENABLE_MINIO=false
# 自带 MinIO 的存储卷容量（随 P8.8 生效）。
#MINIO_STORAGE_SIZE=20Gi

# --- 密钥与首启账号 ----------------------------------------------------------
# 敏感值加密主密钥，64 位 hex（32 字节，openssl rand -hex 32 生成）。留空 = 复用集群
# 已有 Secret，没有则随机生成并在 ENC_KEY_BACKUP_DIR 下留 600 权限备份。轮换只走 --rotate。
#ENC_KEY=
# ENC_KEY 本地备份目录。本文件不做变量展开，请写绝对路径。
#ENC_KEY_BACKUP_DIR=/root/.k8s-ai/keys
# 首启管理员用户名，留空用程序默认。
#ADMIN_USERNAME=
# 首启管理员口令。留空 = 随机生成且只在本次终端输出打印一次，脚本不二次回显。
#ADMIN_PASSWORD=
# 模型 API Key，写进 Secret/k8s-ai-llm 供首次启动兜底；日常改密钥请直接在配置中心页面做。
#LLM_API_KEY=

# --- 权限与超时 --------------------------------------------------------------
# 是否额外下发写权限 RBAC（deploy/rbac-write.example.yaml）。true 会二次确认。
# 关掉时 Agent 只能读，写操作会被集群 RBAC 拒绝。
#ENABLE_WRITE=false
# 各阶段等待超时（秒）：PVC Binding、迁移 Job、滚动升级。
#WAIT_TIMEOUT=300
